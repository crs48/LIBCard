{
  "name": "libcard",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Free, open-source link-in-bio page + virtual business card. Static site, deploys to GitHub Pages.",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/gen-themes.mjs && node scripts/generate-schema.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "setup": "node scripts/setup.mjs",
    "generate:schema": "node scripts/generate-schema.mjs",
    "gen:themes": "node scripts/gen-themes.mjs",
    "new-theme": "node scripts/new-theme.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "shoot-themes": "node scripts/shoot-themes.mjs",
    "update": "node scripts/update.mjs",
    "update-themes": "node scripts/update-themes.mjs",
    "typecheck": "astro check",
    "test": "vitest run --dir src",
    "pretest": "node scripts/prepare-designs.mjs",
    "pretypecheck": "node scripts/prepare-designs.mjs",
    "design:new": "node scripts/design.mjs new",
    "design:list": "node scripts/design.mjs list",
    "design:add": "node scripts/design.mjs add",
    "design:update": "node scripts/design.mjs update",
    "design:rollback": "node scripts/design.mjs rollback",
    "design:fork": "node scripts/design.mjs fork",
    "design:export": "node scripts/design.mjs export",
    "design:check": "node scripts/design.mjs check",
    "design:preview": "node scripts/design.mjs preview",
    "design:catalog": "node scripts/design.mjs catalog",
    "design:schema": "node scripts/design.mjs schema"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "astro": "^5.13.0",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5",
    "sharp": "^0.34.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/qrcode": "^1.5.5",
    "@types/semver": "^7.8.0",
    "parse5": "^7.3.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod-to-json-schema": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
