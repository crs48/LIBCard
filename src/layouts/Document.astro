---
import "../styles/global.css";
import "../../.libcard/themes.css";
import BaseHead from "../components/BaseHead.astro";
import ThemeBoot from "../components/ThemeBoot.astro";
import CornerButton from "../components/CornerButton.astro";
import { getConfig, getActiveTheme, getCardMode, getAnalytics, type LibcardConfig } from "../lib/config";
import { effectsForSlugs, themes } from "../lib/themes";

interface Props {
  title?: string;
  /** Widen the container (used by the multi-column theme gallery). */
  wide?: boolean;
  layout?: string;
  config?: LibcardConfig;
  preview?: boolean;
}

const { title, wide, layout = "classic", preview = false } = Astro.props;
const config = Astro.props.config ?? await getConfig();
const { cornerButton } = config;
// The owner's chosen theme is server-rendered into <html data-theme> so first
// paint, crawlers, and no-JS visitors all see it. The switcher/random mode (if
// enabled) only re-themes on the client.
const theme = await getActiveTheme(config);
// Client theme JS ships only for opt-in theme or color-mode controls.
const themeJs = theme.switcher || theme.random || theme.modeSwitcher || preview;
// Landscape "card mode": the rotate-to-reveal business card. Suppressed on the
// wide gallery layout, where flipping to a card overlay makes no sense.
const card = await getCardMode();
const showCardMode = card.enabled && !wide;
// Page-level effect layers to mount for the active theme set (mesh stage,
// pattern texture). Both are pure CSS; absent unless a theme opts in. The body
// is deliberately NOT given an opaque `bg-bg`: `html` already paints `--lc-bg`,
// and a transparent body lets the fixed mesh stage (z-index:-2) show through.
const candidates = preview ? themes.map((theme) => theme.slug) : theme.switcher || theme.random ? [...theme.cycle, ...theme.randomPool] : [theme.name];
const fx = effectsForSlugs(candidates);
// Opt-in cookieless analytics. The GoatCounter `pixel` mode is the zero-JS path:
// a single <img> beacon rendered at the end of the body (no script at all). The
// Umami auto-tagger decorates outbound links so their clicks are counted; it
// runs only when the owner left `outboundClicks` on. Everything else (the head
// beacons) lives in BaseHead. Null `analytics` → none of this renders.
const analytics = await getAnalytics();
const gcPixel = analytics?.provider === "goatcounter" && analytics.mode === "pixel";
const umamiOutbound = analytics?.provider === "umami" && analytics.outboundClicks;
// Tag every outbound link so Umami records its click as an "outbound" event.
// Emitted via set:html so Astro outputs the JS verbatim (a `{…}` child would be
// parsed as a template expression, not script).
const umamiTagger =
  'for (const a of document.querySelectorAll(\'a[target="_blank"][href^="http"]\')) {' +
  ' a.dataset.umamiEvent = "outbound"; a.dataset.umamiEventUrl = a.href; }';
---
<!doctype html>
<html lang="en" data-theme={theme.name} data-color-mode={theme.mode} data-corner-button={cornerButton ? cornerButton.position : undefined}>
  <head>
    <BaseHead title={title} preview={preview} />
    {/* Restore opted-in visitor choices before paint. System mode itself is CSS-only. */}
    {themeJs && <ThemeBoot pool={theme.randomPool} allowed={preview ? candidates : theme.cycle} random={theme.random} restoreTheme={theme.switcher || theme.random} restoreMode={theme.modeSwitcher} preview={preview} />}
  </head>
  <body data-layout={layout} class="min-h-dvh font-sans antialiased" data-card-mode={showCardMode ? "true" : undefined}>
    {fx.bgStage && <div class="lc-bg-stage" aria-hidden="true" />}
    {fx.pattern && <div class="lc-pattern" aria-hidden="true" />}
    <slot />
    {cornerButton && <CornerButton button={cornerButton} />}
    {/* GoatCounter pixel: the zero-JS analytics path — a 1×1 <img> beacon that
        counts the pageview (and referrer) with no script and no cookie. */}
    {gcPixel && analytics?.provider === "goatcounter" && (
      <img
        src={`https://${analytics.code}.goatcounter.com/count?p=${Astro.url.pathname}`}
        alt=""
        aria-hidden="true"
        width="1"
        height="1"
        referrerpolicy="no-referrer-when-downgrade"
        loading="lazy"
        style="position:absolute;left:-9999px"
      />
    )}
    {/* Umami outbound-click auto-tagger: marks every external link so its click
        registers as an "outbound" event. Only ships when the owner kept it on. */}
    {umamiOutbound && <script is:inline type="module" set:html={umamiTagger} />}
  </body>
</html>
