---
import "../styles/editorial.css";
import Profile from "../components/Profile.astro";
import ProfileActions from "../components/ProfileActions.astro";
import SocialRow from "../components/SocialRow.astro";
import Section from "../components/Section.astro";
import CardReveal from "../components/CardReveal.astro";
import FirstRunNudge from "../components/FirstRunNudge.astro";
import type { LayoutProps } from "../layout-api/model";
type Props = LayoutProps;
const { page, options } = Astro.props;
---
<div class="lc-editorial" data-density={options.density} data-media-tone={options.mediaTone}>
  <main id="main-content">
    <FirstRunNudge />
    <div class="lc-editorial-introduction"><Profile profile={page.profile} editorial /><ProfileActions actions={page.actions} /></div>
    <div class="lc-editorial-sections">{page.sections.map((section, index) => <Section section={section} layout="editorial" index={index} />)}</div>
    <div class="lc-editorial-contact"><SocialRow socials={page.socials} text /><CardReveal url={page.card.url} /></div>
  </main>
  <slot name="utilities" />
</div>
