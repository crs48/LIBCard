---
// The optional client theme controller, included when `theme.switcher` and/or
// `theme.random` is on. It:
//   • (switcher) renders a "Try a theme" button that cycles `data-theme` through
//     the configured ring, persisting the choice and animating with the View
//     Transitions API (instant-swap fallback);
//   • (always, when included) syncs the footer design/layout/theme credits to whatever
//     theme is active on load — which ThemeBoot may have randomized or restored.
import { getConfig, getActiveTheme, type LibcardConfig } from "../lib/config";
import { getThemeMeta, themes } from "../lib/themes";
import { footerCredits, isHomePage } from "../lib/footer";

interface Props { config?: LibcardConfig; preview?: boolean; }
const cfg = Astro.props.config ?? await getConfig();
const active = await getActiveTheme(cfg);
const switcher = active.switcher;

const context = { base: import.meta.env.BASE_URL, home: Astro.props.preview || isHomePage(Astro.url.pathname, import.meta.env.BASE_URL) };
// Resolve the same credits as the server for every possible visitor selection.
const candidates = Astro.props.preview ? themes.map((theme) => theme.slug) : [...active.cycle, ...active.randomPool];
const items = [...new Set(candidates)].map((slug) => {
  const m = getThemeMeta(slug);
  return {
    slug,
    name: m?.name ?? slug,
    credits: footerCredits(cfg, m, context),
  };
});

const poweredBy = cfg.footer.poweredBy;
const animate = active.animate;
const cycle = active.cycle;
---
{
  switcher && (
    <div class="mt-8 flex w-full justify-center">
      <button
        id="lc-theme-next"
        type="button"
        aria-label="Try the next theme"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-fg transition hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
          <circle cx="13.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="17.5" cy="10.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="8.5" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="6.5" cy="12.5" r="1.2" fill="currentColor" stroke="none" />
          <path d="M12 2a10 10 0 1 0 0 20c1.5 0 2-1 2-2 0-1.5-1.5-1.5-1.5-3 0-1 .8-1.5 2-1.5h1.5A4.5 4.5 0 0 0 22 11 10 10 0 0 0 12 2Z" />
        </svg>
        <span>Try a theme</span>
      </button>
      <span id="lc-theme-live" class="sr-only" aria-live="polite" />
    </div>
  )
}

<script is:inline define:vars={{ items, poweredBy, animate, cycle }}>
  const root = document.documentElement;
  const btn = document.getElementById("lc-theme-next");
  const slugs = items.map((i) => i.slug);

  function creditLink(label, href, external = false) {
    const link = document.createElement("a");
    link.textContent = label;
    link.href = href;
    link.className = "underline-offset-4 hover:text-accent hover:underline";
    if (external) { link.target = "_blank"; link.rel = "noopener noreferrer"; }
    return link;
  }
  // Reflect a theme in the footer credit (the footer is parsed after this script,
  // so callers run this on DOMContentLoaded or later).
  function syncBadge(slug) {
    const it = items[slugs.indexOf(slug)];
    if (!it) return;
    const badge = document.getElementById("lc-presentation-credit");
    if (!badge) return;
    badge.hidden = !it.credits.length;
    badge.replaceChildren(...it.credits.map((credit, index) => {
      const part = document.createElement("span");
      part.dataset.creditKind = credit.kind;
      if (poweredBy || index > 0) part.append(" · ");
      part.append(creditLink(credit.name, credit.href), ` ${credit.kind}`);
      if (credit.author) {
        part.append(" by ", credit.authorUrl ? creditLink(credit.author, credit.authorUrl, true) : credit.author);
      }
      return part;
    }));
  }

  function apply(slug) {
    const it = items[slugs.indexOf(slug)];
    const swap = () => {
      root.dataset.theme = slug;
      root.dispatchEvent(new CustomEvent("libcard:theme-change"));
      try {
        localStorage.setItem("libcard-theme", slug);
      } catch {}
      syncBadge(slug);
      const live = document.getElementById("lc-theme-live");
      if (live && it) live.textContent = `Theme: ${it.name}`;
    };
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (animate && !reduced && document.startViewTransition) {
      document.startViewTransition(swap);
    } else {
      swap();
    }
  }

  btn?.addEventListener("click", (e) => {
    // Anchor the circular reveal at the button for a polished wipe.
    root.style.setProperty("--lc-vt-x", `${e.clientX}px`);
    root.style.setProperty("--lc-vt-y", `${e.clientY}px`);
    const current = root.dataset.theme || cycle[0];
    const idx = cycle.indexOf(current);
    apply(cycle[(idx + 1) % cycle.length]);
  });

  // On load, make the footer credit match whatever theme is active (ThemeBoot may
  // have randomized or restored it after the server render).
  const onReady = () => syncBadge(root.dataset.theme);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", onReady);
  } else {
    onReady();
  }
</script>
