---
import { getConfig, getFeedme } from "../lib/config";
import { withBase } from "../lib/site";
import Icon from "./Icon.astro";
import { checkoutUrl, creatorTarget, formatSignal } from "../lib/feedme";

const config = await getConfig();
const { profile } = config;
// Optional Feedme CTA: "Give to <name>" opens the creator's checkout with
// nothing pre-selected (no query string) so the visitor chooses there. Shown
// whenever the integration is enabled and `feedme.give` isn't false — even if
// the public endpoint was down at build time, since Feedme validates everything
// again at checkout. (`give: false` is for owners whose checkout link already
// sits in a `tip-buttons` block.) The name is the LOCAL profile name, so card
// copy stays consistent whatever Feedme says.
const feedme = await getFeedme();
const giveHref = feedme && config.feedme?.give !== false ? checkoutUrl(feedme.origin) : null;
// If the endpoint answered, show the synthesized creator target's public
// signal under the CTA (a build-time snapshot). Unavailable → no numbers.
const creator = creatorTarget(feedme);
const firstName = profile.name.trim().split(/\s+/)[0];
const base = import.meta.env.BASE_URL;
const avatar = profile.avatar
  ? profile.avatar.startsWith("http")
    ? profile.avatar
    : withBase(base, profile.avatar)
  : withBase(base, "/avatar.svg");
---
<header class="flex flex-col items-center text-center gap-3">
  <img
    src={avatar}
    alt={`${profile.name}'s avatar`}
    width="96"
    height="96"
    loading="eager"
    decoding="async"
    class="lc-solid size-24 rounded-full object-cover ring-2 ring-border shadow-sm bg-surface"
  />
  <h1 class="text-2xl font-bold tracking-tight text-fg">{profile.name}</h1>
  {profile.tagline && <p class="text-muted max-w-prose text-balance">{profile.tagline}</p>}
  {
    profile.location && (
      <p class="flex items-center gap-1 text-sm text-muted">
        <Icon name="map-pin" class="size-4" />
        <span>{profile.location}</span>
      </p>
    )
  }
  {
    giveHref && (
      <div class="lc-give mt-1 flex flex-col items-center gap-1.5">
        <a
          href={giveHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 text-sm font-semibold text-accent-contrast shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <Icon name="heart" class="size-4 shrink-0" />
          <span>Give to {profile.name}</span>
        </a>
        <p class="max-w-xs text-xs text-muted text-balance">They get all of it. Where you placed it is a suggestion.</p>
        {creator && (
          <p class="lc-tip-signal text-[11px] text-muted/80">
            Just {firstName}: {formatSignal(creator)}
          </p>
        )}
      </div>
    )
  }
</header>
