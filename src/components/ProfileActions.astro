---
import { getPageModel, type ProfileAction } from "../layout-api/model";
import Icon from "./Icon.astro";
interface Props { actions?: ProfileAction[]; }
const actions = Astro.props.actions ?? (await getPageModel()).actions;
---
{actions.length > 0 && <nav class="lc-profile-actions" aria-label="Contact and business card">
  {actions.map((action) => <a href={action.href} download={action.download}><Icon name={action.icon} class="size-4" />{action.label}</a>)}
</nav>}
<style>
  .lc-profile-actions { display:flex; flex-wrap:wrap; gap: .25rem 1.25rem; }
  a { display:inline-flex; align-items:center; gap:.4rem; min-height:44px; font-size:.8125rem; text-decoration:underline; text-underline-offset:5px; text-decoration-color:var(--lc-border); }
  a:hover { text-decoration-color:currentColor; }
  a:focus-visible { outline:2px solid var(--lc-accent); outline-offset:4px; }
</style>
