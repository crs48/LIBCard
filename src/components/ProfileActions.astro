---
import { getConfig } from "../lib/config";
import { withBase } from "../lib/site";
import Icon from "./Icon.astro";
const config = await getConfig();
type Action = { label: string; href: string; icon: string; download?: string };
const actions = [...new Set(config.profileActions)].flatMap((kind): Action[] => {
  if (kind === "email") return config.contact.email ? [{ label: "Say hello", href: `mailto:${config.contact.email}`, icon: "mail", download: undefined }] : [];
  if (kind === "save-contact") return [{ label: "Save contact", href: withBase(import.meta.env.BASE_URL, "/contact.vcf"), icon: "contact", download: "contact.vcf" }];
  return [{ label: "Show card", href: withBase(import.meta.env.BASE_URL, "/card"), icon: "qr-code", download: undefined }];
});
---
{actions.length > 0 && <nav class="lc-profile-actions" aria-label="Contact and business card">
  {actions.map((action) => <a href={action.href} download={action.download}><Icon name={action.icon} class="size-4" />{action.label}</a>)}
</nav>}
<style>
  .lc-profile-actions { display:flex; flex-wrap:wrap; gap: .25rem 1.25rem; }
  a { display:inline-flex; align-items:center; gap:.4rem; min-height:44px; font-size:.8125rem; text-decoration:underline; text-underline-offset:5px; text-decoration-color:var(--lc-border); }
  a:hover { text-decoration-color:currentColor; }
  a:focus-visible { outline:2px solid var(--lc-accent); outline-offset:4px; }
</style>
