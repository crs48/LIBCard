---
import { getConfig, getFeedme, type LibcardLink } from "../lib/config";
import Icon from "./Icon.astro";
import { parseRepo, formatStars, shieldsStarsUrl, fetchStarCount } from "../lib/github";
import { resolveStatus } from "../lib/status";
import { tipActionFor } from "../lib/feedme";

interface Props {
  link: LibcardLink;
}

const { link } = Astro.props;
const external = /^https?:\/\//i.test(link.url);
// Optional "what state is this in?" chip (zero JS): the link's `status:` slug,
// with the owner's `statuses:` rephrasing applied. null → no chip, no markup.
const status = resolveStatus(link.status, (await getConfig()).statuses);
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;

// Two flavours of sub-pill, rendered to the right of the main button:
//   • companion — `github:` names a repo that backs this link (a live site and
//     its source). Shows the GitHub mark + the star count (no ★ glyph — the
//     mark already says where the number comes from); always on when set.
//   • star      — the link's own `url` IS the repo and the owner opted in via
//     `star: true` / a `stars` mode. Shows "★ <count>" and opens the repo.
const companion = link.github ? parseRepo(link.github) : null;
const repo = companion ?? (link.star || link.stars !== "off" ? parseRepo(link.url) : null);
const pillHref = companion ? link.github! : link.url;

// Bake the live count into the page at build time (fails soft to no count).
let count: string | null = null;
if (repo && link.stars === "build") {
  const n = await fetchStarCount(repo);
  if (n !== null) count = formatStars(n);
}
const badgeSrc = repo && link.stars === "badge" ? shieldsStarsUrl(repo) : null;
const pillLabel = repo
  ? companion
    ? `${repo.owner}/${repo.repo} on GitHub${count ? ` (${count} ${count === "1" ? "star" : "stars"})` : ""}`
    : `Star ${repo.owner}/${repo.repo} on GitHub`
  : undefined;

// Optional Feedme "More of this" action (see lib/feedme.ts). null unless the
// owner enabled the integration AND this link carries its own `feedme:` opt-in
// (and, when the endpoint answered, the target is live). It's a separate anchor
// beside the destination — visiting the link never selects a tip.
const tip = tipActionFor(await getFeedme(), "link", link, link.label);
const tipTitle = tip ? [tip.blurb, tip.signal].filter(Boolean).join(" · ") || "Tip via Feedme" : undefined;
---
<div class="flex w-full items-stretch gap-2">
  <a
    href={link.url}
    target={target}
    rel={rel}
    class="group relative flex min-w-0 flex-1 items-center gap-3 rounded-card bg-surface border border-border px-4 py-3.5 text-fg font-medium shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    {link.icon && <Icon name={link.icon} class="size-5 shrink-0 text-muted group-hover:text-accent transition-colors" />}
    <span class="min-w-0 flex-1 truncate text-center">{link.label}</span>
    {/* Status badge: text + dot, perched on the button's top-right corner like
        a notification badge (absolutely positioned, so the label keeps all its
        room). `bg-surface` masks the border it straddles; it rides along with
        the hover lift because it lives inside the translating <a>. */}
    {
      status && (
        <span
          class="lc-status absolute -top-2 right-3 inline-flex items-center gap-1 rounded-full border border-border bg-surface px-1.5 py-0.5 text-[9px] font-medium uppercase leading-none tracking-wider text-muted/80"
          data-status={status.slug}
          title={`Status: ${status.label}`}
        >
          <span class="lc-status-dot" aria-hidden="true" />
          <span>
            <span class="sr-only">Status: </span>
            {status.label}
          </span>
        </span>
      )
    }
    {/* Only http(s) links open elsewhere; tel:/mailto:/sms: act in-context, so the
        "leaves the page" glyph would be misleading for them. */}
    {external && <Icon name="external-link" class="size-4 shrink-0 text-muted opacity-0 group-hover:opacity-100 transition-opacity" />}
  </a>

  {
    repo && (
      <a
        href={pillHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={pillLabel}
        title={companion ? `Source: ${repo.owner}/${repo.repo}` : undefined}
        class="group flex shrink-0 items-center gap-1.5 rounded-card border border-border bg-surface px-3 text-sm font-medium text-muted shadow-sm transition hover:-translate-y-0.5 hover:border-[#e3b341] hover:text-[#e3b341] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {companion ? (
          <Icon name="github" class="size-4 shrink-0 transition-colors" />
        ) : (
          <Icon name="star" class="size-4 shrink-0 transition-colors group-hover:text-[#e3b341]" />
        )}
        {count && <span>{count}</span>}
        {badgeSrc && <img src={badgeSrc} alt="GitHub stars" height="18" loading="lazy" decoding="async" />}
      </a>
    )
  }

  {
    tip && (
      <a
        href={tip.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={tip.ariaLabel}
        title={tipTitle}
        data-feedme-target={link.feedme?.id}
        class="lc-tip group flex min-h-11 shrink-0 items-center gap-1.5 rounded-card border border-border bg-surface px-2.5 text-xs font-medium text-muted shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <Icon name="heart" class="size-4 shrink-0 transition-colors" />
        <span class="max-sm:sr-only">More of this</span>
      </a>
    )
  }
</div>
{/* Blurb + public-signal caption for an opted-in link. The signal is a BUILD-
    TIME snapshot of Feedme's public aggregate ("75% of public picks · 1 public
    tip"); when the endpoint was unavailable there is simply no number here —
    never a fake zero. Both strings are plain text, escaped by Astro. */}
{
  tip && (tip.blurb || tip.signal) && (
    <p class="lc-tip-caption mt-1 px-1 text-[11px] leading-snug text-muted">
      {tip.blurb && <span>{tip.blurb}</span>}
      {tip.blurb && tip.signal && <span aria-hidden="true"> · </span>}
      {tip.signal && <span class="lc-tip-signal">{tip.signal}</span>}
    </p>
  )
}
