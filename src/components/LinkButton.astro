---
import { getConfig, getFeedme, type LibcardLink } from "../lib/config";
import Icon from "./Icon.astro";
import { resolveLink } from "../lib/link-model";
import { withBase } from "../lib/site";
import type { ResolvedLink } from "../layout-api/model";
interface Props { link: LibcardLink | ResolvedLink; compact?: boolean; }
const { link, compact = false } = Astro.props;
const { external, status, rel, target, companion, repo, count, pillHref, badgeSrc, pillLabel, tip, tipTitle } =
  "presentation" in link ? link.presentation : await resolveLink(link, (await getConfig()).statuses, await getFeedme());
const asset = (src: string) => "presentation" in link || /^https?:\/\//i.test(src) ? src : withBase(import.meta.env.BASE_URL, src);

---
<div class:list={["flex w-full items-stretch gap-2", compact && "lc-compact-link"]} data-link-id={link.id} data-link-presentation={compact ? "compact" : "rich"} data-actions={Number(!!repo) + Number(!!tip)}>
  <a
    href={link.url}
    target={target}
    rel={rel}
    class:list={["group relative flex min-w-0 flex-1 items-center gap-3 rounded-card bg-surface border border-border px-4 py-3.5 text-fg font-medium shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent", compact && "lc-compact-destination"]}
  >
    {!compact && link.iconImage && <img src={asset(link.iconImage)} alt="" width="24" height="24" class="size-6 shrink-0 object-contain" loading="lazy" />}
    {(compact || !link.iconImage) && link.icon && <Icon name={link.icon} class="size-5 shrink-0 text-muted group-hover:text-accent transition-colors" />}
    <span class="min-w-0 flex-1 text-center [overflow-wrap:anywhere]">
      <span>{link.label}</span>
      {!compact && <>
        {link.headline && <span class="mt-2 block whitespace-pre-line">{link.headline}</span>}
        {link.description && <span class="mt-1 block text-sm font-normal leading-relaxed text-muted">{link.description}</span>}
        {link.note && <span class="mt-2 block text-xs font-normal text-muted">{link.note}</span>}
        {link.actionLabel && <span class="mt-2 block text-sm underline underline-offset-4">{link.actionLabel}</span>}
        {link.image && <img src={asset(link.image.src)} alt={link.image.alt} width={link.image.width} height={link.image.height} loading="lazy" decoding="async" class="mt-3 max-h-48 w-full rounded-card object-cover" />}
      </>}
    </span>
    {/* Status badge: text + dot, perched on the button's top-right corner like
        a notification badge (absolutely positioned, so the label keeps all its
        room). `bg-surface` masks the border it straddles; it rides along with
        the hover lift because it lives inside the translating <a>. */}
    {
      status && (
        <span
          class="lc-status absolute -top-2 right-3 inline-flex items-center gap-1 rounded-full border border-border bg-surface px-1.5 py-0.5 text-[9px] font-medium leading-none tracking-wider text-muted/80"
          data-status={status.slug}
          title={`Status: ${status.label}`}
        >
          <span class="lc-status-dot" aria-hidden="true" />
          <span>
            <span class="sr-only">Status: </span>
            {status.label}
          </span>
        </span>
      )
    }
    {/* Only http(s) links open elsewhere; tel:/mailto:/sms: act in-context, so the
        "leaves the page" glyph would be misleading for them. */}
    {external && <Icon name="external-link" class="size-4 shrink-0 text-muted opacity-0 group-hover:opacity-100 transition-opacity" />}
  </a>

  {
    repo && (
      <a
        href={pillHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={pillLabel}
        title={companion ? `Source: ${repo.owner}/${repo.repo}` : undefined}
        class:list={["group flex shrink-0 items-center gap-1.5 rounded-card border border-border bg-surface px-3 text-sm font-medium text-muted shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent", compact ? "lc-compact-action min-w-11 justify-center hover:border-accent hover:text-accent" : "hover:border-[#e3b341] hover:text-[#e3b341]"]}
      >
        {companion ? (
          <Icon name="github" class="size-4 shrink-0 transition-colors" />
        ) : (
          <Icon name="star" class="size-4 shrink-0 transition-colors group-hover:text-[#e3b341]" />
        )}
        {count && <span>{count}</span>}
        {!compact && badgeSrc && <img src={badgeSrc} alt="GitHub stars" height="18" loading="lazy" decoding="async" />}
      </a>
    )
  }

  {
    tip && (
      <a
        href={tip.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={tip.ariaLabel}
        title={tipTitle}
        data-feedme-target={link.feedme?.id}
        class:list={["lc-tip group flex min-h-11 shrink-0 items-center gap-1.5 rounded-card border border-border bg-surface px-2.5 text-xs font-medium text-muted shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent", compact && "lc-compact-action min-w-11 justify-center"]}
      >
        <Icon name="heart" class="size-4 shrink-0 transition-colors" />
        <span class={compact ? "sr-only" : "max-sm:sr-only"}>More of this</span>
      </a>
    )
  }
</div>
{/* Blurb + public-signal caption for an opted-in link. The signal is a BUILD-
    TIME snapshot of Feedme's public aggregate ("75% of public picks · 1 public
    tip"); when the endpoint was unavailable there is simply no number here —
    never a fake zero. Both strings are plain text, escaped by Astro. */}
{
  tip && (tip.blurb || tip.signal) && (
    <p class="lc-tip-caption mt-1 px-1 text-[11px] leading-snug text-muted">
      {tip.blurb && <span>{tip.blurb}</span>}
      {tip.blurb && tip.signal && <span aria-hidden="true"> · </span>}
      {tip.signal && <span class="lc-tip-signal">{tip.signal}</span>}
    </p>
  )
}
<style>
  .lc-compact-destination { min-height: 54px; }
  .lc-compact-action { min-height: 44px; }
  /* Leave room for the title when a narrow row has both source and tip actions. */
  @media (max-width: 400px) {
    .lc-compact-link[data-actions="2"] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lc-compact-link[data-actions="2"] .lc-compact-destination { grid-column: 1 / -1; }
  }
</style>
