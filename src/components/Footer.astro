---
// Credit the complete design, or the actual layout/theme combination in use.
import { getConfig, getActiveTheme, hasLiveEmbeds, getAnalytics, hasRemoteMedia } from "../lib/config";
import { getThemeMeta, LIBCARD_REPO } from "../lib/themes";
import { footerCredits, isHomePage } from "../lib/footer";
import type { LibcardConfig } from "../lib/config";
import DesignSwitcher from "./DesignSwitcher.astro";

interface Props { config?: LibcardConfig; preview?: boolean; }
const { config, preview = false } = Astro.props;
const cfg = config ?? await getConfig();
const active = await getActiveTheme(cfg);
const meta = getThemeMeta(active.name);

const poweredBy = cfg.footer.poweredBy;
// Coarse, non-identifying attribution on the badge link. It ships no JS and sets
// no cookies. The real signal is the click's Referer header, which shows up under
// the repo's Insights → Traffic → "Referring sites" — so the badge link keeps
// rel="noopener" (security) but drops "noreferrer" so the referring card is
// visible. The ?ref tag is just an explicit breadcrumb; nothing per-visitor is
// tracked. (External author-credit links keep noreferrer; only this one needs it.)
const poweredByHref = `${LIBCARD_REPO}?ref=card`;
// Be honest about the one place the "nothing tracks you" promise has an asterisk:
// a live embed (video/booking/map/…) loads third-party content in its iframe.
// Video defaults to a click-to-load facade, so nothing loads until interaction.
const liveEmbeds = hasLiveEmbeds(cfg);
const remoteMedia = hasRemoteMedia(cfg);
// Honest one-liner when cookieless analytics is on — same spirit as the live-
// embed disclosure above. Only shown when the owner opted in; never by default.
const analytics = await getAnalytics();

const credits = footerCredits(cfg, meta, {
  base: import.meta.env.BASE_URL,
  home: preview || isHomePage(Astro.url.pathname, import.meta.env.BASE_URL),
});
---
<footer class="mt-10 text-center text-xs text-muted" data-libcard-utilities>
  <p>
    {
      poweredBy && (
        <a
          href={poweredByHref}
          target="_blank"
          rel="noopener"
          class="underline-offset-4 hover:text-accent hover:underline"
        >
          Powered by LibCard
        </a>
      )
    }
    <span id="lc-presentation-credit" hidden={!credits.length}>
      {credits.map((credit, index) => <span data-credit-kind={credit.kind}>
        {(poweredBy || index > 0) && " · "}
        <a href={credit.href} class="underline-offset-4 hover:text-accent hover:underline">{credit.name}</a>{" "}{credit.kind}
        {credit.author && <> by {credit.authorUrl
          ? <a href={credit.authorUrl} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-accent hover:underline">{credit.author}</a>
          : <span>{credit.author}</span>}</>}
      </span>)}
    </span>
  </p>
  {
    liveEmbeds && (
      <p class="mt-1 text-[0.7rem] text-muted/80">Some embedded content loads from third parties.</p>
    )
  }
  {remoteMedia && <p class="mt-1 text-[0.7rem] text-muted/80">Some project images load from third parties.</p>}
  {
    analytics && (
      <p class="mt-1 text-[0.7rem] text-muted/80">This page counts anonymous visits — no cookies, no personal data.</p>
    )
  }
  {cfg.footer.designGallery && <DesignSwitcher current={cfg.design ?? "classic"} preview={preview} />}
</footer>
