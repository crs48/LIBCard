---
import type { LinkSection } from "../lib/page";
import LinkButton from "./LinkButton.astro";
import EditorialLink from "./EditorialLink.astro";
interface Props { section: LinkSection; layout: "classic" | "editorial"; }
const { section, layout } = Astro.props;
---
<ul class:list={["lc-link-group", layout === "classic" && "flex w-full flex-col gap-3"]}>
  {section.links.map((link) => <li>{layout === "editorial" ? <EditorialLink link={link} /> : <LinkButton link={link} />}</li>)}
</ul>
