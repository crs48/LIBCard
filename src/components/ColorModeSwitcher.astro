---
import { getActiveTheme } from "../lib/config";
import { getThemeMeta } from "../lib/themes";
const active = await getActiveTheme();
const defaultMode = active.mode;
const candidates = active.switcher || active.random ? [...active.cycle, ...active.randomPool] : [active.name];
const dualThemes = [...new Set(candidates)].filter((slug) => {
  const theme = getThemeMeta(slug);
  const modes = new Set([theme?.mode, ...Object.keys(theme?.schemes ?? {})]);
  return modes.has("light") && modes.has("dark");
});
---
<label id="lc-color-mode-control" class="lc-color-mode" hidden>
  <span>Appearance</span>
  <select id="lc-color-mode" aria-label="Color mode">
    <option value="system" selected={defaultMode === "system"}>System</option>
    <option value="light" selected={defaultMode === "light"}>Light</option>
    <option value="dark" selected={defaultMode === "dark"}>Dark</option>
  </select>
</label>
<script is:inline define:vars={{ dualThemes, defaultMode }}>
  (() => {
    const root = document.documentElement;
    const control = document.getElementById("lc-color-mode-control");
    const select = document.getElementById("lc-color-mode");
    const valid = (mode) => ["system", "light", "dark"].includes(mode);
    const sync = () => {
      control.hidden = !dualThemes.includes(root.dataset.theme);
      select.value = root.dataset.colorMode || defaultMode;
    };
    select.addEventListener("change", () => {
      if (!valid(select.value)) return;
      root.dataset.colorMode = select.value;
      try { localStorage.setItem("libcard-color-mode", select.value); } catch {}
    });
    root.addEventListener("libcard:theme-change", sync);
    window.addEventListener("storage", (event) => {
      if (event.key !== "libcard-color-mode" && event.key !== null) return;
      root.dataset.colorMode = valid(event.newValue) ? event.newValue : defaultMode;
      sync();
    });
    sync();
  })();
</script>
<style>
  .lc-color-mode { display: flex; align-items: center; justify-content: center; gap: .5rem; margin-top: 1rem; color: var(--lc-muted); font-size: .75rem; }
  .lc-color-mode[hidden] { display: none; }
  select { min-height: 36px; padding: .25rem .5rem; border: 1px solid var(--lc-border); border-radius: .375rem; background: var(--lc-bg); color: var(--lc-fg); font: inherit; cursor: pointer; }
  select:focus-visible { outline: 2px solid var(--lc-accent); outline-offset: 3px; }
  @media print { .lc-color-mode { display: none; } }
</style>
