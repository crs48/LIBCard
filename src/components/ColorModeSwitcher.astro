---
import { getActiveTheme } from "../lib/config";
import { getThemeMeta } from "../lib/themes";
const active = await getActiveTheme();
const defaultMode = active.mode;
const candidates = active.switcher || active.random ? [...active.cycle, ...active.randomPool] : [active.name];
const dualThemes = [...new Set(candidates)].filter((slug) => {
  const theme = getThemeMeta(slug);
  const modes = new Set([theme?.mode, ...Object.keys(theme?.schemes ?? {})]);
  return modes.has("light") && modes.has("dark");
});
---
<button id="lc-color-mode-control" class="lc-color-mode" type="button" aria-label="Switch to dark mode" hidden>
  <svg class="lc-mode-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" /></svg>
  <svg class="lc-mode-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
</button>
<script is:inline define:vars={{ dualThemes, defaultMode }}>
  (() => {
    const root = document.documentElement;
    const control = document.getElementById("lc-color-mode-control");
    const system = window.matchMedia("(prefers-color-scheme: dark)");
    const valid = (mode) => ["system", "light", "dark"].includes(mode);
    const isDark = () => {
      const mode = root.dataset.colorMode || defaultMode;
      return mode === "dark" || (mode === "system" && system.matches);
    };
    const sync = () => {
      control.hidden = !dualThemes.includes(root.dataset.theme);
      control.dataset.mode = isDark() ? "dark" : "light";
      const label = isDark() ? "Switch to light mode" : "Switch to dark mode";
      control.setAttribute("aria-label", label);
      control.title = label;
    };
    control.addEventListener("click", () => {
      const mode = isDark() ? "light" : "dark";
      root.dataset.colorMode = mode;
      try { localStorage.setItem("libcard-color-mode", mode); } catch {}
      sync();
    });
    root.addEventListener("libcard:theme-change", sync);
    system.addEventListener("change", sync);
    window.addEventListener("storage", (event) => {
      if (event.key !== "libcard-color-mode" && event.key !== null) return;
      root.dataset.colorMode = valid(event.newValue) ? event.newValue : defaultMode;
      sync();
    });
    sync();
  })();
</script>
<style>
  .lc-color-mode { display: inline-grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--lc-muted); cursor: pointer; }
  .lc-color-mode[hidden] { display: none; }
  .lc-color-mode:hover { background: var(--lc-surface); color: var(--lc-fg); }
  .lc-color-mode:focus-visible { outline: 2px solid var(--lc-accent); outline-offset: 3px; }
  svg { grid-area: 1 / 1; width: 15px; height: 15px; }
  .lc-color-mode[data-mode="dark"] .lc-mode-moon,
  .lc-color-mode[data-mode="light"] .lc-mode-sun { display: none; }
  @media (pointer: coarse), (max-width: 560px) {
    .lc-color-mode { flex-basis: 44px; width: 44px; height: 44px; }
    svg { width: 18px; height: 18px; }
  }
  @media print { .lc-color-mode { display: none; } }
</style>
