---
import Document from "../layouts/Document.astro";
import { getConfig } from "../lib/config";
import { absoluteUrl } from "../lib/site";
const config = await getConfig();
const { default: Home } = config.layout === "editorial"
  ? await import("../layouts/Editorial.astro")
  : await import("../layouts/Classic.astro");
const cardUrl = absoluteUrl(Astro.site, import.meta.env.BASE_URL, "/");
---
<Document layout={config.layout}><Home cardUrl={cardUrl} /></Document>
