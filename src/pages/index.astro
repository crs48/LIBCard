---
import Document from "../layouts/Document.astro";
import { getConfig } from "../lib/config";
import { createPageModel } from "../layout-api/model";
import Home from "@libcard/selected";
import PageUtilities from "../components/PageUtilities.astro";
const config = await getConfig();
const page = await createPageModel(config, import.meta.env.BASE_URL, Astro.site);
---
<Document layout={config.layout}><Home page={page} options={config.options}><PageUtilities slot="utilities" /></Home></Document>
