{
  "$ref": "#/definitions/LibcardConfig",
  "definitions": {
    "LibcardConfig": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "tagline": {
              "type": "string"
            },
            "avatar": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "contact": {
          "type": "object",
          "properties": {
            "email": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "email"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            },
            "phone": {
              "type": "string"
            },
            "organization": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "website": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "icon": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ready",
                  "wip",
                  "experiment",
                  "exploration",
                  "writing",
                  "reading",
                  "dormant"
                ]
              },
              "github": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?:\\/\\/github\\.com\\/[^/?#]+\\/[^/?#]+?(?:\\.git)?\\/?$"
              },
              "star": {
                "type": "boolean",
                "default": false
              },
              "stars": {
                "type": "string",
                "enum": [
                  "off",
                  "build",
                  "badge"
                ],
                "default": "off"
              },
              "feedme": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                    "description": "Stable target id, unique across links and socials. Lowercase slug, 1–64 chars. Required unless skip is true."
                  },
                  "skip": {
                    "type": "boolean",
                    "description": "true keeps this item off Feedme entirely. Takes no other fields."
                  },
                  "blurb": {
                    "type": "string",
                    "maxLength": 240,
                    "description": "Plain-text blurb, at most 240 characters."
                  },
                  "aspiration": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Optional aspiration in whole US dollars (0–1,000,000). 0 or omitted means none."
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "statuses": {
          "type": "object",
          "properties": {
            "ready": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: ready"
            },
            "wip": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: wip"
            },
            "experiment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: experiment"
            },
            "exploration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: exploration"
            },
            "writing": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: writing"
            },
            "reading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: reading"
            },
            "dormant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Chip text for links with status: dormant"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "blocks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "copy-prompt"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000,
                    "description": "Plain-text prompt. Omit for LibCard's guided setup prompt."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "default": "Copy setup prompt"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "heading"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 4,
                    "default": 2
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "markdown": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "markdown"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "divider"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "contact-buttons"
                  },
                  "call": {
                    "type": [
                      "boolean",
                      "string"
                    ]
                  },
                  "sms": {
                    "type": "string"
                  },
                  "whatsapp": {
                    "type": "string"
                  },
                  "telegram": {
                    "type": "string"
                  },
                  "signal": {
                    "type": "string"
                  },
                  "email": {
                    "type": [
                      "boolean",
                      "string"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "tip-buttons"
                  },
                  "venmo": {
                    "type": "string"
                  },
                  "paypal": {
                    "type": "string"
                  },
                  "wise": {
                    "type": "string"
                  },
                  "feedme": {
                    "type": "boolean",
                    "default": false
                  },
                  "feedmeLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "feedmeNote": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 280
                      },
                      {
                        "type": "boolean",
                        "const": false
                      }
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "gallery"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "src": {
                          "type": "string",
                          "minLength": 1
                        },
                        "alt": {
                          "type": "string"
                        },
                        "href": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "uri"
                            },
                            {
                              "type": "string",
                              "const": ""
                            }
                          ]
                        }
                      },
                      "required": [
                        "src"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "images"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "faq"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "q": {
                          "type": "string",
                          "minLength": 1
                        },
                        "a": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "q",
                        "a"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "video"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "youtube",
                      "vimeo",
                      "loom"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string"
                  },
                  "facade": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "type",
                  "provider",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "embed"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "spotify",
                      "applemusic",
                      "soundcloud",
                      "bandcamp",
                      "figma",
                      "twitch",
                      "tiktok",
                      "bluesky",
                      "mastodon",
                      "gforms",
                      "typeform",
                      "airtable",
                      "codepen",
                      "oembed"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "const": ""
                      }
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "type",
                  "provider"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "booking"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "calendly",
                      "calcom",
                      "gcal"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "title": {
                    "type": "string"
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "type",
                  "provider",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "map"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "gmaps",
                      "osm"
                    ],
                    "default": "gmaps"
                  },
                  "src": {
                    "type": "string",
                    "format": "uri"
                  },
                  "title": {
                    "type": "string"
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "type",
                  "src"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "signup"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "buttondown",
                      "mailchimp",
                      "kit",
                      "formspree"
                    ]
                  },
                  "username": {
                    "type": "string"
                  },
                  "action": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "const": ""
                      }
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "button": {
                    "type": "string"
                  },
                  "placeholder": {
                    "type": "string"
                  },
                  "redirect": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "const": ""
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "provider"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "form"
                  },
                  "action": {
                    "type": "string",
                    "format": "uri"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "email",
                            "tel",
                            "textarea"
                          ],
                          "default": "text"
                        },
                        "required": {
                          "type": "boolean",
                          "default": false
                        },
                        "placeholder": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "button": {
                    "type": "string"
                  },
                  "redirect": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "string",
                        "const": ""
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "action",
                  "fields"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "tweet"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rss"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 5
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "github"
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repo": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "user"
                ],
                "additionalProperties": false
              }
            ]
          },
          "default": []
        },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "string"
              },
              "feedme": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                    "description": "Stable target id, unique across links and socials. Lowercase slug, 1–64 chars. Required unless skip is true."
                  },
                  "skip": {
                    "type": "boolean",
                    "description": "true keeps this item off Feedme entirely. Takes no other fields."
                  },
                  "blurb": {
                    "type": "string",
                    "maxLength": 240,
                    "description": "Plain-text blurb, at most 240 characters."
                  },
                  "aspiration": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Optional aspiration in whole US dollars (0–1,000,000). 0 or omitted means none."
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "platform",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "switcher": {
                  "type": "boolean",
                  "default": false
                },
                "random": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ],
                  "default": false
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "animate": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          ],
          "default": "default"
        },
        "footer": {
          "type": "object",
          "properties": {
            "poweredBy": {
              "type": "boolean",
              "default": true
            },
            "themeCredit": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "seo": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "ogImage": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "meta": {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "cardMode": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "qr": {
              "type": "string",
              "enum": [
                "page",
                "contact",
                "both"
              ],
              "default": "page"
            },
            "hint": {
              "type": "boolean",
              "default": true
            },
            "wakeLock": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "analytics": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "goatcounter"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "pixel",
                    "script"
                  ],
                  "default": "pixel"
                }
              },
              "required": [
                "provider",
                "code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "umami"
                },
                "websiteId": {
                  "type": "string",
                  "minLength": 1
                },
                "src": {
                  "type": "string",
                  "format": "uri",
                  "default": "https://cloud.umami.is/script.js"
                },
                "outboundClicks": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "provider",
                "websiteId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "plausible"
                },
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "src": {
                  "type": "string",
                  "format": "uri",
                  "default": "https://plausible.io/js/script.outbound-links.js"
                }
              },
              "required": [
                "provider",
                "domain"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "cloudflare"
                },
                "token": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "token"
              ],
              "additionalProperties": false
            }
          ]
        },
        "feedme": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "origin": {
              "type": "string",
              "description": "Your Feedme origin, e.g. https://tips.example.com — required when enabled."
            },
            "give": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "site": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "base": {
              "type": "string",
              "default": "/"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "site"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
